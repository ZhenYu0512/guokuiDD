<view class="page">
  <view class="card">
    <!-- 图片 -->
    <view class="img-row" bindtap="chooseImage">
      <image wx:if="{{imageUrl || localImage}}" src="{{imageUrl || localImage}}" mode="aspectFill" class="img-preview" />
      <view wx:else class="img-placeholder">
        <view class="plus">+</view>
        <view class="tip">{{uploading ? '上传中...' : '上传商品图'}}</view>
      </view>
      <view class="img-note">不上传时使用占位图\n后续可接入对象存储</view>
    </view>

    <view class="form-row">
      <text class="label">分类</text>
      <picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange" class="picker">
        {{categoryIndex >= 0 ? categories[categoryIndex].name : '请选择分类'}}
      </picker>
    </view>
    <view class="form-row">
      <text class="label">名称</text>
      <input value="{{name}}" bindinput="onNameInput" placeholder="如 招牌牛肉锅盔" />
    </view>
    <view class="form-row">
      <text class="label">价格(元)</text>
      <input type="digit" value="{{price}}" bindinput="onPriceInput" placeholder="如 15.00" />
    </view>
    <view class="form-row">
      <text class="label">库存</text>
      <input type="number" value="{{stock}}" bindinput="onStockInput" />
    </view>
    <view class="form-row">
      <text class="label">描述</text>
      <input value="{{description}}" bindinput="onDescInput" placeholder="一句话介绍（选填）" />
    </view>
    <view class="form-row">
      <text class="label">招牌推荐</text>
      <switch checked="{{isFeatured}}" color="#b5341f" bindchange="onFeaturedChange" />
    </view>
  </view>

  <button class="btn-primary submit" disabled="{{submitting || uploading}}" bindtap="submit">
    {{uploading ? '图片上传中...' : (submitting ? '保存中...' : '保存商品')}}
  </button>
</view>
