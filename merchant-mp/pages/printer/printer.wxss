.card-title { font-weight: bold; margin-bottom: 16rpx; }
.bt-status { font-size: 26rpx; color: #999; margin-bottom: 20rpx; }
.bt-status.on { color: #4caf50; font-weight: bold; }
.btn-row { display: flex; gap: 20rpx; }
.btn { padding: 14rpx 36rpx; border-radius: 36rpx; font-size: 26rpx; color: #fff; background: #b5341f; }
.btn.plain { background: #fff; color: #666; border: 1rpx solid #ddd; }
.btn.small { padding: 10rpx 26rpx; font-size: 24rpx; }
.btn.primary { background: #b5341f; }
.device { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; background: #f7f7f7; border-radius: 12rpx; margin-top: 16rpx; }
.tip { margin-top: 16rpx; line-height: 1.6; }
.printer { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f3f3f3; }
.printer:last-child { border-bottom: none; }
.tag { font-size: 18rpx; background: #fdeceb; color: #b5341f; padding: 2rpx 10rpx; border-radius: 6rpx; margin-left: 10rpx; }
