<view class="page">
  <!-- 自提信息 -->
  <view class="card">
    <view class="card-title">自提信息</view>
    <view class="form-row">
      <text class="form-label">取餐人</text>
      <input value="{{contactName}}" bindinput="onNameInput" placeholder="请输入姓名" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input type="number" maxlength="11" value="{{contactPhone}}" bindinput="onPhoneInput" placeholder="请输入手机号" />
    </view>
    <view class="form-row">
      <text class="form-label">备注</text>
      <input value="{{remark}}" bindinput="onRemarkInput" placeholder="口味要求等（选填）" />
    </view>
  </view>

  <!-- 商品清单（展示价，后端重算） -->
  <view class="card">
    <view class="card-title">商品清单</view>
    <view class="item" wx:for="{{cart}}" wx:key="key">
      <image src="{{item.image}}" mode="aspectFill" class="item-img" />
      <view class="item-info">
        <view>{{item.name}}</view>
        <view class="item-spec">{{item.specText}}{{item.addonText ? ' + ' + item.addonText : ''}}</view>
      </view>
      <view class="item-right">
        <view>x{{item.quantity}}</view>
        <view class="price">¥{{item.subtotalText}}</view>
      </view>
    </view>
  </view>

  <!-- 优惠 -->
  <view class="card">
    <view class="form-row">
      <text class="form-label">优惠券</text>
      <picker range="{{couponLabels}}" value="{{couponIndex + 1}}" bindchange="onCouponChange" class="picker">
        {{couponIndex >= 0 ? coupons[couponIndex].name : (coupons.length ? '请选择（' + coupons.length + ' 张可用）' : '暂无可用')}}
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">积分抵扣</text>
      <input type="number" value="{{usePoints}}" bindinput="onPointsInput"
        placeholder="可用 {{userPoints}} 积分，1 积分抵 0.01 元" />
    </view>
  </view>

  <!-- 金额明细 -->
  <view class="card">
    <view class="amount-row"><text>商品金额</text><text>¥{{totalText}}</text></view>
    <view class="amount-row"><text>优惠券</text><text>-¥{{couponDiscountText}}</text></view>
    <view class="amount-row"><text>积分抵扣</text><text>-¥{{pointsDiscountText}}</text></view>
    <view class="amount-row total"><text>应付</text><text class="price">¥{{payText}}</text></view>
  </view>

  <button class="btn-primary submit" disabled="{{submitting}}" bindtap="submit">
    {{submitting ? '提交中...' : '提交并支付 ¥' + payText}}
  </button>
</view>
