<view class="menu-page">
  <!-- 左侧分类 -->
  <scroll-view scroll-y class="cat-list">
    <view
      wx:for="{{categories}}" wx:key="id"
      class="cat-item {{activeCat === index ? 'cat-active' : ''}}"
      data-index="{{index}}" bindtap="tapCat">
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 右侧商品 -->
  <scroll-view scroll-y class="prod-list" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view wx:for="{{categories}}" wx:key="id" id="cat-{{index}}">
      <view class="prod-cat-title">{{item.name}}</view>
      <view class="prod-item" wx:for="{{item.products}}" wx:for-item="p" wx:key="id">
        <image src="{{p.imageUrl}}" mode="aspectFill" class="prod-img" />
        <view class="prod-info">
          <view class="prod-name">{{p.name}}<text class="tag" wx:if="{{p.isFeatured}}">招牌</text></view>
          <view class="prod-desc">{{p.description}}</view>
          <view class="prod-bottom">
            <text class="price">¥{{p.priceText}}</text>
            <view class="add-btn" data-product="{{p}}" bindtap="openSpec" wx:if="{{!p.isSoldOut}}">选规格</view>
          </view>
        </view>
        <!-- 售罄遮罩 -->
        <view class="soldout-mask" wx:if="{{p.isSoldOut}}">已售罄</view>
      </view>
    </view>
  </scroll-view>

  <!-- 购物车栏 -->
  <view class="cart-bar">
    <view class="cart-left" bindtap="clearCart">
      🛒 <text class="cart-count" wx:if="{{cartCount}}">{{cartCount}}</text>
    </view>
    <view class="cart-total price">¥{{cartTotalText}}</view>
    <view class="cart-go {{cartCount ? '' : 'cart-go-disabled'}}" bindtap="goConfirm">去结算</view>
  </view>

  <!-- 规格选择弹窗 -->
  <view class="spec-mask" wx:if="{{showSpec}}" >
  
    <view class="spec-panel" catchtap="">
      <view class="spec-head" wx:if="{{current}}">
        <image src="{{current.imageUrl}}" mode="aspectFill" class="spec-img" />
        <view>
          <view class="spec-name">{{current.name}}</view>
          <view class="price">¥{{current.priceText}} 起</view>
        </view>
        <view class="closeSpec" bindtap="closeSpec">
          关闭
        </view>
      </view>

      <!-- 规格组（单选） -->
      <view wx:for="{{current.specGroups}}" wx:key="id" wx:for-item="g" class="spec-group">
        <view class="spec-group-name">{{g.name}}<text class="required" wx:if="{{g.isRequired}}">（必选）</text></view>
        <view class="opt-list">
          <view
            wx:for="{{g.options}}" wx:key="id" wx:for-item="o"
            class="opt {{selectedSpecs[g.id] === o.id ? 'opt-active' : ''}}"
            data-group="{{g.id}}" data-option="{{o.id}}" bindtap="pickSpec">
            {{o.name}}<text wx:if="{{o.priceDelta > 0}}"> +¥{{o.priceDelta / 100}}</text>
          </view>
        </view>
      </view>

      <!-- 加料（多选，上限3） -->
      <view class="spec-group" wx:if="{{addons.length}}">
        <view class="spec-group-name">加料（最多 3 个）</view>
        <view class="opt-list">
          <view
            wx:for="{{popupAddons}}" wx:key="id"
            class="opt {{item.checked ? 'opt-active' : ''}}"
            data-index="{{index}}" bindtap="toggleAddon">
            {{item.name}} +¥{{item.priceText}}
          </view>
        </view>
      </view>

      <!-- 数量 -->
      <view class="qty-row">
        <text>数量</text>
        <view class="qty-ctrl">
          <view class="qty-btn" data-delta="-1" bindtap="changeQty">-</view>
          <text class="qty-num">{{quantity}}</text>
          <view class="qty-btn" data-delta="1" bindtap="changeQty">+</view>
        </view>
      </view>

      <button class="btn-primary" bindtap="addToCart">加入购物车</button>
    </view>
  </view>
</view>
