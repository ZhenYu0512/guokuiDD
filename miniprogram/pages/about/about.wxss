.logo-box { text-align: center; padding: 60rpx 0 40rpx; }
.logo { font-size: 48rpx; font-weight: bold; color: #b5341f; }
.slogan { color: #999; font-size: 24rpx; margin-top: 12rpx; }
.card-title { font-weight: bold; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 26rpx; border-bottom: 1rpx solid #f3f3f3; }
.row:last-child { border-bottom: none; }
.label { color: #666; flex-shrink: 0; margin-right: 30rpx; }
.footer { text-align: center; color: #bbb; font-size: 22rpx; margin-top: 60rpx; line-height: 1.8; }
