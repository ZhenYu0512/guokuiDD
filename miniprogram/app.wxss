page {
  background: #f6f6f6;
  font-size: 28rpx;
  color: #333;
}
.btn-primary {
  background: #b5341f;
  color: #fff;
  border-radius: 44rpx;
}
.price {
  color: #b5341f;
  font-weight: bold;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #fdeceb;
  color: #b5341f;
  margin-right: 10rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}
